{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "allowJs": true, "checkJs": false, "isolatedModules": true,
    "verbatimModuleSyntax": true, "esModuleInterop": true,
    "resolveJsonModule": true, "strict": true, "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
